<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Snowdrift</AssemblyName>
    <RootNamespace>Snowdrift</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Snowdrift.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Snowdrift</Product>
    <Company>Snowdrift contributors</Company>
    <Description>Snowdrift — snow on your desktop</Description>
    <Copyright>MIT License</Copyright>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CA1416;CS0649;CS0169;CS8981</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.*" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.*" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.*" />
  </ItemGroup>

</Project>
